{
  "name": "water-sort-h5",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/create-static-worker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check": "npm run test && npm run test:scripts && npm run build && npm run check:size"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
